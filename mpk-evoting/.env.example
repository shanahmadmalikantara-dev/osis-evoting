# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings -> API, and Project Settings -> Database -> Connection string).
# NEVER commit .env.local.

# Public values (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET: server and local scripts only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# SECRET: only for `npm run setup` (applies the database migrations).
# Use the "Session pooler" connection string and put your database password in it.
# Keep the double quotes: a # in the password would otherwise be read as a comment.
DATABASE_URL=""

# Optional: email domain for the generated accounts (no email is ever sent).
AUTH_EMAIL_DOMAIN=pemilu-mpk.local
