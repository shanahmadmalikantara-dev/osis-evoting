{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pemilu OSIS Cadangan",
  "version": "1.0.0",
  "identifier": "id.sch.man4jakarta.pemiluosis.cadangan",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pemilu OSIS - Bilik Cadangan",
        "width": 1366,
        "height": 768,
        "minWidth": 1024,
        "minHeight": 640,
        "fullscreen": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "publisher": "OSIS MAN 4 Jakarta",
    "shortDescription": "Bilik suara cadangan (offline)",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    }
  }
}
